# 전부 선택입니다. 비워두거나 이 파일이 없어도 기본값으로 돕니다.

# 거래소: gate(기본) 또는 binance
#  Render 무료 서버는 미국이라 바이낸스는 지역 차단(HTTP 451)에 걸릴 수 있습니다.
EXCHANGE=gate

# 검사할 시간봉 (5m,15m,30m,1h,4h,1d 중에서 쉼표로)
TIMEFRAMES=15m,1h,4h,1d

# 24시간 거래대금 상위 몇 개를 검사할지 (10~500)
TOP_N=150

# 이 금액(USDT)보다 거래대금이 적은 종목은 제외
MIN_VOLUME=1000000

# 비코인(주식·ETF·원자재)으로 표시할 티커를 더 추가 (쉼표로)
EXTRA_NON_CRYPTO=

PORT=3000

# --- 텔레그램 ------------------------------------------------------------
# 둘 다 있어야 보냅니다. 없으면 로그에만 남깁니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# RSI 다이버전스 확정 알림 (기본 켜짐). off 로 끕니다
DIV_ALERT=on
# 어느 시간봉을 알릴지 (쉼표로)
DIV_ALERT_TIMEFRAMES=1h,4h,1d
# all, bull, bear 중 하나
DIV_ALERT_SIDE=all
# regular(기본), hidden, all 중 하나
DIV_ALERT_KIND=regular
# on 이면 첫 피벗 RSI 가 30 이하(상승)·70 이상(하락)인 것만. off 로 끕니다
DIV_ALERT_ZONE_ONLY=on
# 24시간 거래대금(USDT)이 이보다 적은 종목은 알리지 않음 (기본 500만)
DIV_ALERT_MIN_VOLUME=5000000
# 두 번째 피벗이 이 봉 수보다 오래되면 새 신호로 보지 않음
DIV_ALERT_MAX_AGE=6

# 하모닉 PRZ 텔레그램 알림은 기본으로 끕니다. 화면(/harmonic.html)만 봅니다.
HARMONIC_TELEGRAM=off
# off 로 두면 하모닉 감시를 끕니다
HARMONIC=on
HARMONIC_TIMEFRAMES=1h,4h
# 몇 분마다 검사할지
HARMONIC_INTERVAL_MIN=5
# PRZ 상단까지 이 % 안으로 내려오면 "접근" 메시지
HARMONIC_NEAR_PCT=1
# 아래 셋은 트레이딩뷰 지표의 같은 이름 설정과 맞추세요 (기본값이 지표 기본값)
HARMONIC_DEV_PCT=10
HARMONIC_TOL_PCT=10
HARMONIC_PRZ_PCT=3
