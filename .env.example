# 전부 선택입니다. 비워두거나 이 파일이 없어도 기본값으로 돕니다.

# 거래소: gate(기본) 또는 binance
#  Render 무료 서버는 미국이라 바이낸스는 지역 차단(HTTP 451)에 걸릴 수 있습니다.
EXCHANGE=gate

# 검사할 시간봉 (5m,15m,30m,1h,4h,1d 중에서 쉼표로)
TIMEFRAMES=15m,1h,4h,1d

# 24시간 거래대금 상위 몇 개를 검사할지 (10~500)
TOP_N=150

# 이 금액(USDT)보다 거래대금이 적은 종목은 제외
MIN_VOLUME=1000000

# 비코인(주식·ETF·원자재)으로 표시할 티커를 더 추가 (쉼표로)
EXTRA_NON_CRYPTO=

PORT=3000

# --- 하모닉 PRZ 텔레그램 알림 ---------------------------------------------
# 둘 다 있어야 보냅니다. 없으면 로그에만 남깁니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# off 로 두면 하모닉 감시를 끕니다
HARMONIC=on
HARMONIC_TIMEFRAMES=1h,4h
# 몇 분마다 검사할지
HARMONIC_INTERVAL_MIN=5
# PRZ 상단까지 이 % 안으로 내려오면 "접근" 메시지
HARMONIC_NEAR_PCT=1
# 아래 셋은 트레이딩뷰 지표의 같은 이름 설정과 맞추세요 (기본값이 지표 기본값)
HARMONIC_DEV_PCT=10
HARMONIC_TOL_PCT=10
HARMONIC_PRZ_PCT=3
