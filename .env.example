# 전부 선택입니다. 비워두거나 이 파일이 없어도 기본값으로 돕니다.

# 거래소: gate(기본) 또는 binance
#  Render 무료 서버는 미국이라 바이낸스는 지역 차단(HTTP 451)에 걸릴 수 있습니다.
EXCHANGE=gate

# 검사할 시간봉 (5m,15m,30m,1h,4h,1d 중에서 쉼표로)
TIMEFRAMES=15m,1h,4h,1d

# 24시간 거래대금 상위 몇 개를 검사할지 (10~500)
TOP_N=150

# 이 금액(USDT)보다 거래대금이 적은 종목은 제외
MIN_VOLUME=1000000

# 비코인(주식·ETF·원자재)으로 표시할 티커를 더 추가 (쉼표로)
EXTRA_NON_CRYPTO=

PORT=3000
